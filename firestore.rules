rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function memberOf(spaceId) {
      return request.auth != null
        && request.auth.uid in
           get(/databases/$(database)/documents/spaces/$(spaceId)).data.members;
    }

    match /spaces/{spaceId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;

      // 更新できるのは「いまの」メンバーだけ。
      // 以前は更新“後”のメンバーを見ていたため、スペースIDさえ知っていれば
      // 招待コード無しで自分を members に足して入れた（外した相手もそのまま戻れた）。
      // 参加は joinSpace 関数（管理者権限）が行うので、ここは自己追加を許さない。
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
      allow delete: if false;

      match /records/{recordId} {
        allow read, write: if memberOf(spaceId);
      }
    }

    // 招待コード。中身を読む必要があるのはサーバ（joinSpace 関数）だけなので読ませない。
    // 作成・削除はそのスペースのメンバーだけ（作成時と、外したあとの作り直しに使う）。
    match /invites/{code} {
      allow read, update: if false;
      allow create: if request.auth != null && memberOf(request.resource.data.spaceId);
      allow delete: if request.auth != null && memberOf(resource.data.spaceId);
    }
  }
}
